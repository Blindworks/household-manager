<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260227-0010" author="household-manager">
        <comment>Add is_estimated column to mark auto-generated interpolated readings for missed Fridays</comment>

        <addColumn tableName="meter_readings">
            <column name="is_estimated" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="meter_readings" columnName="is_estimated"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
