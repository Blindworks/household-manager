<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261125-0118-add-thermostat-room-target" author="benedikt">
        <comment>Optionale Raum-Solltemperatur je Thermostat: mit Raumfuehler regelt das Backend den Sollwert des Thermostats nach dem Raumwert.</comment>
        <addColumn tableName="thermostat">
            <column name="room_target" type="DOUBLE"/>
        </addColumn>
        <rollback><dropColumn tableName="thermostat" columnName="room_target"/></rollback>
    </changeSet>

</databaseChangeLog>
