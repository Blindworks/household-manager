<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261110-0095-recurring-dismissed" author="benedikt">
        <comment>Wiederkehrende Zahlungen: "Verwerfen" markiert statt zu loeschen, damit ein spaeterer Lauf
            den Eintrag wiederfindet und nicht erneut als Kandidat anlegt.</comment>
        <addColumn tableName="recurring_payments">
            <column name="dismissed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
