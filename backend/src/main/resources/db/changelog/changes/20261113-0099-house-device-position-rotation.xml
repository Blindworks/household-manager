<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261113-0099-house-device-position-rotation" author="benedikt">
        <comment>Digitaler Zwilling: gespeicherte Drehung eines Grossgeraete-Koerpers (0/90/180/270 Grad), NULL = automatisch zur Wand.</comment>
        <addColumn tableName="house_device_position">
            <column name="rotation_deg" type="INT"/>
        </addColumn>
        <rollback><dropColumn tableName="house_device_position" columnName="rotation_deg"/></rollback>
    </changeSet>

</databaseChangeLog>
