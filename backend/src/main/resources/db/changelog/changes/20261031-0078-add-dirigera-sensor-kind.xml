<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Ein DDL je Changeset: MariaDB committet DDL implizit -->
    <changeSet id="20261031-0078-add-dirigera-sensor-kind" author="claude">
        <comment>Art des Dirigera-Sensors (ENVIRONMENT = Thermometer, CONTACT = Fenster-/Tuerkontakt); der Bestand sind Thermometer.</comment>
        <addColumn tableName="dirigera_sensor">
            <column name="kind" type="VARCHAR(20)" defaultValue="ENVIRONMENT"><constraints nullable="false"/></column>
        </addColumn>
        <rollback><dropColumn tableName="dirigera_sensor" columnName="kind"/></rollback>
    </changeSet>

</databaseChangeLog>
