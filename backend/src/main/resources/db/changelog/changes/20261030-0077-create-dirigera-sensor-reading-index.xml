<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261030-0077-create-dirigera-sensor-reading-index" author="claude">
        <comment>Index fuer Zeitreihenabfragen je Sensor (eigenes Changeset wegen MariaDB-DDL-Autocommit).</comment>
        <createIndex tableName="dirigera_sensor_reading" indexName="idx_dirigera_reading_sensor_time">
            <column name="sensor_id"/>
            <column name="measured_at"/>
        </createIndex>
        <rollback><dropIndex tableName="dirigera_sensor_reading" indexName="idx_dirigera_reading_sensor_time"/></rollback>
    </changeSet>

</databaseChangeLog>
