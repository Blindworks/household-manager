<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260727-0044-a" author="household-manager">
        <comment>Kalender-Kategorien werden Stammdaten; cat_key ist der stabile Schluessel, auf den Flows filtern.</comment>

        <createTable tableName="calendar_category">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cat_key" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_calendar_category_key"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="color" type="VARCHAR(7)">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="VARCHAR(50)"/>
            <column name="sort_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Die Schluessel sind exakt die Strings, die der Erinnerungs-Scheduler bisher
             als Event-State geschrieben hat: bestehende Flows bleiben lauffaehig. -->
        <insert tableName="calendar_category">
            <column name="cat_key" value="general"/><column name="name" value="Allgemein"/>
            <column name="color" value="#64b5f6"/><column name="sort_order" valueNumeric="1"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="calendar_category">
            <column name="cat_key" value="family"/><column name="name" value="Familie"/>
            <column name="color" value="#ba68c8"/><column name="sort_order" valueNumeric="2"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="calendar_category">
            <column name="cat_key" value="health"/><column name="name" value="Gesundheit"/>
            <column name="color" value="#e57373"/><column name="sort_order" valueNumeric="3"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="calendar_category">
            <column name="cat_key" value="household"/><column name="name" value="Haushalt"/>
            <column name="color" value="#81c784"/><column name="sort_order" valueNumeric="4"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="calendar_category">
            <column name="cat_key" value="work"/><column name="name" value="Arbeit"/>
            <column name="color" value="#ffb74d"/><column name="sort_order" valueNumeric="5"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="calendar_category">
            <column name="cat_key" value="birthday"/><column name="name" value="Geburtstag"/>
            <column name="color" value="#f06292"/><column name="sort_order" valueNumeric="6"/>
            <column name="active" valueBoolean="true"/>
        </insert>

        <rollback>
            <dropTable tableName="calendar_category"/>
        </rollback>
    </changeSet>

    <!--
        Die Umstellung von calendar_events.category (Enum-Text) auf category_id ist bewusst auf
        DREI Changesets verteilt und darf nicht zusammengefasst werden.

        MariaDB/MySQL committen jedes DDL implizit — ein Changeset mit mehreren DDL-Schritten
        laesst sich nach einem Fehler in der Mitte nicht zurueckrollen. -b3 bricht bei
        unerwarteten Daten absichtlich ab (siehe dort). Waere alles ein Changeset, stuende die
        Spalte danach bereits in der Tabelle, das Changeset aber nicht in DATABASECHANGELOG:
        der naechste Start wiederholte es und scheiterte an "Duplicate column name
        'category_id'" — auch nach korrigierten Daten, also dauerhaft ohne manuelles ALTER TABLE.

        Die Trennlinie verlaeuft nicht entlang "ein Schritt pro Changeset", sondern entlang
        WIEDERHOLBARKEIT: -b1 (addColumn) und -b4 (dropColumn) scheitern bei einer Wiederholung
        und brauchen deshalb ein eigenes Changeset *und* eine Vorbedingung (siehe dort) — die
        Aufteilung allein deckt nur den Datenfehler ab, nicht eine bereits halb migrierte
        Tabelle aus einer frueheren Fassung dieser Datei. UPDATE, MODIFY ... NOT NULL und
        ADD CONSTRAINT sind bei einer Wiederholung dagegen unschaedlich und gehoeren zusammen
        in -b3 — insbesondere muss das UPDATE mit dem abbrechenden Schritt zusammenliegen.
        Laege es allein davor, waere es nach einem Abbruch als gelaufen vermerkt und die
        naheliegende Reparatur (den unbekannten Enum-Text in calendar_events.category
        berichtigen) bliebe wirkungslos: category_id bliebe NULL und -b3 scheiterte endlos
        erneut. So wirkt die Reparatur an der alten Spalte wie erwartet.

        (Die Id -b2 ist historisch und bleibt frei — Liquibase-Ids werden nie wiederverwendet.)
    -->
    <changeSet id="20260727-0044-b1" author="household-manager">
        <!-- preConditions muss laut Schema das erste Kind von changeSet sein, noch vor comment.

             Die Aufteilung allein reicht nicht: Auf einer Datenbank, auf der eine fruehere,
             noch gebuendelte Fassung dieses Changesets lief, steht die Spalte bereits in der
             Tabelle, ohne dass eine der neuen Ids protokolliert waere. Ohne diese Vorbedingung
             scheitert der Start dann dauerhaft an "Duplicate column name 'category_id'".
             MARK_RAN statt CONTINUE, damit -b1 nicht bei jedem Start erneut geprueft wird. -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="calendar_events" columnName="category_id"/>
            </not>
        </preConditions>

        <comment>Schritt 1/3: Spalte category_id anlegen (noch nullable) — nicht wiederholbar.</comment>

        <addColumn tableName="calendar_events">
            <column name="category_id" type="BIGINT"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="calendar_events" columnName="category_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20260727-0044-b3" author="household-manager">
        <comment>Schritt 2/3: Daten umschreiben und category_id verbindlich machen. Bricht bei unbekanntem Enum-Text ab.</comment>

        <sql>
            UPDATE calendar_events e
            SET e.category_id = (SELECT c.id FROM calendar_category c WHERE c.cat_key = LOWER(e.category))
        </sql>

        <!-- Bleibt eine Zeile ohne Treffer, schlaegt addNotNullConstraint fehl und Liquibase
             bricht den Start ab. Gewollt: lauter Abbruch statt stiller Reparatur auf
             "Allgemein". Das UPDATE liegt bewusst im selben Changeset, damit es beim naechsten
             Start erneut laeuft (siehe Kommentar oben). -->
        <addNotNullConstraint tableName="calendar_events" columnName="category_id" columnDataType="BIGINT"/>

        <addForeignKeyConstraint
                baseTableName="calendar_events" baseColumnNames="category_id"
                referencedTableName="calendar_category" referencedColumnNames="id"
                constraintName="fk_calendar_events_category" onDelete="RESTRICT"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="calendar_events" constraintName="fk_calendar_events_category"/>
            <dropNotNullConstraint tableName="calendar_events" columnName="category_id" columnDataType="BIGINT"/>
        </rollback>
    </changeSet>

    <changeSet id="20260727-0044-b4" author="household-manager">
        <!-- Gegenstueck zu -b1 (dort steht auch, warum preConditions vor comment gehoert):
             hat eine fruehere Fassung die Spalte bereits entfernt, ist hier nichts mehr zu tun. -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="calendar_events" columnName="category"/>
        </preConditions>

        <comment>Schritt 3/3: alte Enum-Spalte entfernen — nicht wiederholbar.</comment>

        <dropColumn tableName="calendar_events" columnName="category"/>

        <rollback>
            <addColumn tableName="calendar_events">
                <column name="category" type="VARCHAR(30)"/>
            </addColumn>
            <sql>
                UPDATE calendar_events e
                SET e.category = (SELECT UPPER(c.cat_key) FROM calendar_category c WHERE c.id = e.category_id)
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
