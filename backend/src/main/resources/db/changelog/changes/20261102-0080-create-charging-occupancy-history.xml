<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261102-0080-create-charging-occupancy-history" author="benedikt">
        <comment>Abgeschlossene Belegungen je Ladepunkt (Beginn/Ende), Grundlage der Ladesaeulen-Vorhersage.</comment>
        <createTable tableName="charging_occupancy_history">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="station_id" type="VARCHAR(191)"><constraints nullable="false"/></column>
            <column name="chargepoint_id" type="VARCHAR(191)"><constraints nullable="false"/></column>
            <column name="started_at" type="DATETIME"><constraints nullable="false"/></column>
            <column name="ended_at" type="DATETIME"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="charging_occupancy_history"/></rollback>
    </changeSet>

</databaseChangeLog>
