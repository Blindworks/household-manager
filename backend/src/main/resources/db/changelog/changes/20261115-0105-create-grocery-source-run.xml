<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261115-0105-create-grocery-source-run" author="benedikt">
        <comment>Supermarkt-Angebote: Ergebnis des letzten Abrufs je Quelle.</comment>
        <createTable tableName="grocery_source_run">
            <column name="source_key" type="VARCHAR(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="last_run_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="offer_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ok" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(300)"/>
        </createTable>
        <rollback><dropTable tableName="grocery_source_run"/></rollback>
    </changeSet>

</databaseChangeLog>
