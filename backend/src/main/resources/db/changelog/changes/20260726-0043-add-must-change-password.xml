<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260726-0043" author="household-manager">
        <comment>Erzwungener Passwortwechsel: Bootstrap-Admin startet mit "changeit".</comment>

        <addColumn tableName="app_user">
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="app_user" columnName="must_change_password"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
