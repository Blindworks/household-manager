<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261120-0112-create-grocery-run-log" author="benedikt">
        <comment>Supermarkt-Angebote: Protokoll je Lauf (Kennzahlen plus Details als JSON).</comment>
        <createTable tableName="grocery_run_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trigger_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="ok" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="error" type="VARCHAR(500)"/>
            <column name="offers" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="raw_offers" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="products" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ai_calls" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="estimate_calls" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="input_tokens" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="output_tokens" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ai_failures" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="deferred" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="new_judgements" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="deals" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="source_failures" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="details" type="LONGTEXT"/>
        </createTable>
        <rollback><dropTable tableName="grocery_run_log"/></rollback>
    </changeSet>

</databaseChangeLog>
