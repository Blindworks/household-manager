<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261105-0086-add-thermostat-room-sensor" author="benedikt">
        <comment>Optional zugeordneter Raum-Temperaturfuehler je Thermostat (sensorId aus /v1/temperatures, z. B. "dirigera:3").</comment>
        <addColumn tableName="thermostat">
            <column name="room_sensor_id" type="VARCHAR(80)"/>
        </addColumn>
        <rollback><dropColumn tableName="thermostat" columnName="room_sensor_id"/></rollback>
    </changeSet>

</databaseChangeLog>
