<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261123-0115-create-charging-watch" author="claude">
        <comment>
            Auftraege "Benachrichtigen, wenn frei" je Station und Person; ueberleben einen Deploy.
            Der zusammengesetzte Primaerschluessel haelt das Changeset bei einem einzigen DDL.
        </comment>
        <createTable tableName="charging_watch">
            <column name="station_id" type="VARCHAR(191)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_charging_watch_user"
                             references="app_user(id)" deleteCascade="true"/>
            </column>
            <column name="station_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="charging_watch"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
